# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development

# Defines "today" for generating recurring entries.
APP_TIMEZONE=Asia/Kolkata

# postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/expense_tracker

# Must be true in production (HTTPS). Set false only for local http development.
COOKIE_SECURE=false

SESSION_TTL_DAYS=30

# Only needed if the browser calls the API directly instead of via the Next.js /api proxy.
# JSON list, e.g. ["http://localhost:3000"]
CORS_ORIGINS=[]
